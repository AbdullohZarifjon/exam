# Copy this file to `.env` and adjust the values before running:
#   docker compose up --build
#
# All values below are optional; docker-compose.yml provides the same defaults.

# JWT signing secret (must be at least 32 characters for HS256)
JWT_SECRET=change-me-in-production-at-least-32-characters-long

# MinIO / S3 endpoint, credentials and bucket
S3_ENDPOINT=https://s3.sardorkhurramov.uz:9001
S3_ACCESS_KEY=admin
S3_SECRET_KEY=maxfiy-parol
S3_BUCKET=zarif-aka
S3_REGION=us-east-1
STORAGE_PRESIGNED_URL_EXPIRATION=900

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Initial admin account created on first start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Administrator

# Initial teacher account created on first start
SEED_TEACHER_USERNAME=teacher
SEED_TEACHER_PASSWORD=teacher123
SEED_TEACHER_FULL_NAME=Teacher

# Initial test student created on first start
SEED_STUDENT_FULL_NAME=Test Student
SEED_STUDENT_CODE=STU-2026-1
