NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/exam_db
JWT_ACCESS_SECRET=replace-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=replace-me-refresh-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
# Bootstrap admin — created automatically on first boot if absent.
# ADMIN is the admin USERNAME. Staff accounts can never be registered
# from outside; only this admin can create teachers/admins afterwards.
ADMIN=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# On-prem face service (no cloud egress)
FACE_SERVICE_URL=http://localhost:8000
FACE_MATCH_THRESHOLD=0.60
FACE_GAP_THRESHOLD=0.08
FACE_MODEL=buffalo_s
FACE_CONSENT_VERSION=v1-uz
